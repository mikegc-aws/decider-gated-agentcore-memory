# Copy to .env and fill in. .env is gitignored.

# Required only for `--decider jev` (Jev via OpenRouter).
OPENROUTER_API_KEY="sk-or-v1-..."

# The strands-decider-2b SageMaker endpoint. There is no public deployment of
# this model; point these at your own endpoint if you have one.
# DECIDER_ENDPOINT="my-decider-endpoint"
# DECIDER_REGION="us-west-2"
